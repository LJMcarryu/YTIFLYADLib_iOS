# 本示例固定使用 6.5.4；请运行 pod install 生成锁文件。安装与运行需在宿主 App 中验证。
# 历史 Tag、Release 和资产保持不可变。

source 'https://cdn.cocoapods.org/'
platform :ios, '11.0'



target 'YTIFLYADLibSimple' do
  use_frameworks!
  # 优推 YT 媒体定制 SDK：静态 framework，仅开屏/插屏，支持图片和视频。
  # 二进制托管在本仓 TOS 发布记录，通过固定版本 Tag 获取 Podspec；静态库随 app 链接（无需 Embed），
  # 资源包 YTAdvSDK.bundle 经 podspec s.resources 自动拷入 app，-ObjC 由 podspec 自动注入。
  # 固定使用 6.5.4；Podspec 由固定版本 Tag 提供，同版本二进制由 TOS 下载。
  pod 'YTIFLYADLib', :podspec => 'https://raw.githubusercontent.com/LJMcarryu/YTIFLYADLib_iOS/6.5.4/YTIFLYADLib.podspec'
end
